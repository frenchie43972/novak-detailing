# Canonical production URL, for example https://www.novakdetailing.com
NUXT_PUBLIC_SITE_URL=

# Keep false until the production domain is live and ready for search engines.
NUXT_SITE_INDEXABLE=false

# Optional verification tokens. Add them after creating the webmaster accounts.
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_BING_SITE_VERIFICATION=
